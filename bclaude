#!/usr/bin/env bash
# bclaude — run Claude Code inside a rootless podman container.
#
# Single file: the Containerfile and the container entrypoint are embedded
# below, so downloading this script is all you need.
#
#   bclaude                      interactive session on $PWD
#   bclaude -p "summarize this"  claude flags pass straight through
#   bclaude shell                a shell in the container instead
#   bclaude doctor               check that the host is set up correctly
#
# See `bclaude help` for the full interface.
set -euo pipefail

BCLAUDE_VERSION="1.0.0"
BCLAUDE_URL="${BCLAUDE_URL:-https://raw.githubusercontent.com/torlenor/bclaude/main/bclaude}"

# ---------------------------------------------------------------------------
# Defaults (every one of these can be overridden by env var or by a flag)
# ---------------------------------------------------------------------------
# The four names below are read only from their BCLAUDE_ form, unlike the tuning
# knobs further down. IMAGE, WORKSPACE and VOLUME are ordinary words that projects
# and CI already export for their own purposes, and these four decide what gets
# mounted and what `bclaude clean` deletes: inheriting a stray `export IMAGE=`
# would aim `podman rmi -f` at somebody else's image.
IMAGE="${BCLAUDE_IMAGE:-localhost/bclaude:latest}"
WORKSPACE="${BCLAUDE_WORKSPACE:-$PWD}"
VOLUME_DEFAULT="bclaude-config"
VOLUME_EXPLICIT=""                           # 1 when the volume was named by hand
if [ -n "${BCLAUDE_VOLUME:-}" ]; then VOLUME_EXPLICIT=1; fi
VOLUME="${BCLAUDE_VOLUME:-$VOLUME_DEFAULT}"
VOLUME_PER_PROJECT="${BCLAUDE_VOLUME_PER_PROJECT:-}"
# The login lives apart from the rest of the config, in one volume shared by
# every project, so per-project config volumes don't mean logging in per project.
AUTH_VOLUME="${BCLAUDE_AUTH_VOLUME:-bclaude-auth}"
AUTH_DIR="/home/claude/.claude-auth"
HOST_CREDS="${HOST_CREDS:-$HOME/.claude/.credentials.json}"
CLAUDE_VERSION="${CLAUDE_VERSION:-latest}"   # npm tag/version baked into the image
MEMORY="${MEMORY:-4g}"                       # empty disables the memory cap
CPUS="${CPUS:-2}"                            # empty disables the cpu cap
TMPFS_SIZE="${TMPFS_SIZE:-512m}"
ALLOW_PKG="${ALLOW_PKG:-}"
SEED_CONFIG="${SEED_CONFIG:-}"
SEED_CREDS="${SEED_CREDS:-}"                 # 1 copies the host token in
READONLY_WORKSPACE="${BCLAUDE_RO:-}"         # 1 mounts /work read-only
AUTOBUILD="${BCLAUDE_AUTOBUILD:-1}"          # 0 disables build-on-demand
GIT_CONFIG_MOUNT="${BCLAUDE_GIT_CONFIG:-1}"  # 0 disables mounting ~/.gitconfig
ALLOW_ROOT="${BCLAUDE_ALLOW_ROOT:-}"         # 1 permits rootful podman
DRY_RUN=""
FORCE_REBUILD=""
NO_CACHE=""

# The uid/gid of the claude user in the image. The userns mapping aims the host
# user at these, so they are the one place that number is written down.
CONTAINER_UID=1000
CONTAINER_GID=1000

SELINUX_RELABEL=""                           # 1 adds the z option to bind mounts

RECIPE_LABEL="org.bclaude.recipe"
VOLUME_LABEL="org.bclaude.managed"           # marks the volumes bclaude created
ROLE_LABEL="org.bclaude.role"                # config | auth
WORKSPACE_LABEL="org.bclaude.workspace"      # per-project volumes: their project

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------
if [ -t 2 ]; then
    C_RED=$'\033[31m'; C_YEL=$'\033[33m'; C_GRN=$'\033[32m'
    C_DIM=$'\033[2m';  C_OFF=$'\033[0m'
else
    C_RED=""; C_YEL=""; C_GRN=""; C_DIM=""; C_OFF=""
fi

info() { printf '%sbclaude:%s %s\n' "$C_DIM" "$C_OFF" "$*" >&2; }
warn() { printf '%sbclaude: warning:%s %s\n' "$C_YEL" "$C_OFF" "$*" >&2; }
die()  { printf '%sbclaude: error:%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; exit 1; }

# mount_opts [opt...] -> the ":a,b" tail of a --volume argument, adding the
# SELinux relabel option when the host needs it. Building this by hand is how
# ",z" ends up concatenated onto a mount that has no options yet, which podman
# reads as part of the destination path: "/work,z" becomes the mountpoint and
# /work stays empty, silently. Every --volume goes through here.
mount_opts() {
    local opts="" o
    for o in "$@"; do opts="${opts:+$opts,}$o"; done
    [ -n "$SELINUX_RELABEL" ] && opts="${opts:+$opts,}z"
    printf '%s' "${opts:+:$opts}"
}

# ---------------------------------------------------------------------------
# Embedded Containerfile
# ---------------------------------------------------------------------------
containerfile_text() {
    cat <<'CONTAINERFILE'
FROM docker.io/library/node:22-bookworm-slim

# Pin this to a specific version (e.g. 2.1.218) for a reproducible image.
ARG CLAUDE_VERSION=latest

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        openssh-client \
        procps \
        ripgrep \
        python3 \
        python3-venv \
        sudo \
    && rm -rf /var/lib/apt/lists/*

# Passwordless apt for the claude user. This is inert by default: the runtime
# runs with no-new-privileges + cap-drop=ALL, which blocks sudo entirely. It
# only takes effect when bclaude is run with --allow-pkg, which relaxes those
# two flags. Scoped to package tooling rather than a blanket ALL.
RUN echo 'claude ALL=(root) NOPASSWD: /usr/bin/apt-get, /usr/bin/apt, /usr/bin/dpkg' \
        > /etc/sudoers.d/claude-apt \
    && chmod 0440 /etc/sudoers.d/claude-apt

# Strip setuid/setgid from everything except sudo (needed for --allow-pkg).
# These bits are inert under NoNewPrivs + cap-drop=ALL, but become latent
# privilege paths the moment that posture is relaxed. su, mount, passwd, chsh,
# etc. are never needed here.
RUN find / -xdev -perm /6000 -type f ! -path /usr/bin/sudo \
        -exec chmod ug-s {} + 2>/dev/null || true

# The node image ships a uid/gid 1000 user called "node". Rename it to "claude";
# the runtime's --userns=keep-id:uid=1000,gid=1000 aims the host user at this uid,
# whatever the host user's own uid happens to be.
RUN groupmod -n claude node \
    && usermod -l claude -d /home/claude -m node

RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_VERSION} \
    && npm cache clean --force

# .claude is the mountpoint for the config volume and .claude-auth for the
# shared login volume; creating them here owned by claude means podman's volume
# copy-up gets the ownership right.
RUN mkdir -p /work /home/claude/.claude /home/claude/.claude-auth /home/claude/.npm-global \
    && chown -R claude:claude /work /home/claude \
    && chmod 700 /home/claude/.claude /home/claude/.claude-auth

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

USER claude
WORKDIR /work

ENV HOME=/home/claude \
    SHELL=/bin/bash \
    CLAUDE_CONFIG_DIR=/home/claude/.claude \
    npm_config_prefix=/home/claude/.npm-global \
    PATH=/home/claude/.npm-global/bin:/usr/local/bin:/usr/bin:/bin:/usr/games:/usr/local/games

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["claude"]
CONTAINERFILE
}

# ---------------------------------------------------------------------------
# Embedded entrypoint (runs inside the container)
# ---------------------------------------------------------------------------
entrypoint_text() {
    cat <<'ENTRYPOINT'
#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
AUTH_DIR="${BCLAUDE_AUTH_DIR:-$HOME/.claude-auth}"
SEED="/run/host-claude/.credentials.json"
CREDS="$CONFIG_DIR/.credentials.json"
AUTH_CREDS="$AUTH_DIR/.credentials.json"

mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR"

# The login lives in its own volume, shared by every project, while the config
# dir around it can be per-project. Claude Code only ever looks at $CONFIG_DIR,
# so the login is copied in on the way up and back out on the way down: the
# token is refreshed during a session, and that refreshed token has to reach the
# other projects.
#
# Direction of truth: the auth volume decides what you start with, the config
# dir decides what you end with -- but only where the two actually differ, and
# only if nobody else moved the auth volume underneath us. AUTH_CREDS_IN is what
# the auth volume held when we started, taken before anything is copied in, and
# every decision on the way out is a comparison against it:
#
#   config ends equal to it    nothing of ours to add, leave the volume alone
#   volume no longer equals it a session that started with us refreshed and
#                              exited first; its token is newer, so it stands
#   otherwise                  publish
#
# The first rule is what stops an untouched session putting a spent token back
# over a live one. The catch it must not swallow: a config dir holding the only
# copy of a login (a volume from before the auth/config split, or a fresh
# --auth-volume alongside an existing config volume) has to reach the empty auth
# volume. Fingerprinting the volume rather than the config dir is what keeps
# those two apart -- "the volume gave us nothing and we have something" is a
# difference, so it publishes.

# Empty for a missing file, and never non-zero: this runs under `set -e` inside
# an assignment, where a failing substitution would take the whole session down.
creds_fingerprint() {
    [ -s "$1" ] || return 0
    { sha256sum < "$1" 2>/dev/null | cut -d' ' -f1; } || true
}
AUTH_CREDS_IN=""
SEEDED=""

sync_auth_out() {
    { [ -d "$AUTH_DIR" ] && [ -s "$CREDS" ]; } || return 0
    # An explicit --seed-creds is an instruction: it always publishes.
    if [ -z "$SEEDED" ]; then
        # Moved under us by a session that refreshed after we started -- which
        # includes it logging in while our auth volume was still empty.
        if [ "$(creds_fingerprint "$AUTH_CREDS")" != "$AUTH_CREDS_IN" ]; then
            echo "[entrypoint] another session refreshed the login; keeping theirs" >&2
            return 0
        fi
        # We end with exactly what the volume gave us, so there is nothing to say.
        [ "$(creds_fingerprint "$CREDS")" = "$AUTH_CREDS_IN" ] && return 0
    fi
    install -m 600 "$CREDS" "$AUTH_CREDS" 2>/dev/null \
        || echo "[entrypoint] warning: could not store the login in $AUTH_DIR" >&2
}

if [ -d "$AUTH_DIR" ]; then
    trap sync_auth_out EXIT
    # Before the copy-in, so this is the volume's state and not the config dir's.
    AUTH_CREDS_IN="$(creds_fingerprint "$AUTH_CREDS")"
    [ -s "$AUTH_CREDS" ] && install -m 600 "$AUTH_CREDS" "$CREDS"
fi

# Copy the host's OAuth credentials in. The seed is mounted (read-only) only
# when the caller asked for it with --seed-creds, so its presence is the
# instruction: copy it in, replacing whatever is there — that is how a stale
# token gets refreshed. Without the flag there is no seed and the container logs
# in on its own.
if [ -s "$SEED" ]; then
    install -m 600 "$SEED" "$CREDS"
    SEEDED=1
    echo "[entrypoint] seeded credentials from host" >&2
fi

if [ ! -s "$CREDS" ] && [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo "[entrypoint] warning: no credentials found; run 'claude' and log in." >&2
fi

# With valid credentials present, an interactive launch still shows the
# login/onboarding flow unless hasCompletedOnboarding is set. Headless (-p)
# runs skip onboarding, so this only bites interactive sessions. Seed the flag
# (and a theme, to skip the theme picker) into the config's .claude.json.
CONFIG_JSON="$CONFIG_DIR/.claude.json"
if [ -s "$CREDS" ] || [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    [ -s "$CONFIG_JSON" ] || echo '{}' > "$CONFIG_JSON"
    tmp="$(mktemp "$CONFIG_DIR/.claude.json.XXXXXX")"
    if jq '.hasCompletedOnboarding = true
           | .theme = (.theme // "dark")
           | .lastOnboardingVersion = (.lastOnboardingVersion // "2.1.218")' \
           "$CONFIG_JSON" > "$tmp" 2>/dev/null; then
        chmod 600 "$tmp"
        mv "$tmp" "$CONFIG_JSON"
    else
        rm -f "$tmp"
        echo "[entrypoint] warning: could not update $CONFIG_JSON" >&2
    fi
fi

# Opt-in config seeding (--seed-config on the host wrapper mounts these as
# read-only seed sources under /run/host-claude). Copied every run so the config
# reflects your current host config. Host paths in settings.json are rewritten
# from $HOST_HOME/.claude to the container's $CONFIG_DIR (e.g. the statusline
# command's script path).
if [ -s /run/host-claude/settings.json ]; then
    if [ -n "${HOST_HOME:-}" ]; then
        sed "s#${HOST_HOME}/.claude#${CONFIG_DIR}#g" \
            /run/host-claude/settings.json > "$CONFIG_DIR/settings.json"
    else
        cp /run/host-claude/settings.json "$CONFIG_DIR/settings.json"
    fi
    chmod 600 "$CONFIG_DIR/settings.json"
    echo "[entrypoint] seeded settings.json from host" >&2
fi
if [ -s /run/host-claude/statusline-command.sh ]; then
    install -m 700 /run/host-claude/statusline-command.sh \
        "$CONFIG_DIR/statusline-command.sh"
fi

# Args passed to `podman run <image> ...` replace CMD wholesale, so re-attach
# `claude` unless the caller clearly asked for something else (e.g. `bash`).
# Claude subcommands are listed explicitly because some of them collide with
# real binaries on PATH (notably `install`).
case "${1:-}" in
    "")
        set -- claude
        ;;
    -*|config|mcp|plugin|doctor|update|install|migrate-installer|setup-token)
        set -- claude "$@"
        ;;
    *)
        command -v "$1" >/dev/null 2>&1 || set -- claude "$@"
        ;;
esac

# Not exec: the login has to be written back to the shared auth volume when the
# session ends (the EXIT trap above), so this stays as pid 1 and claude runs as
# its child, in the foreground, with the terminal.
rc=0
"$@" || rc=$?
exit "$rc"
ENTRYPOINT
}

# Hash of everything that determines the image contents. Stamped onto the image
# as a label at build time so a run can tell whether the image still matches
# this script, and rebuild it if not.
recipe_hash() {
    local hasher
    if command -v sha256sum >/dev/null 2>&1; then hasher=sha256sum
    elif command -v shasum >/dev/null 2>&1; then hasher="shasum -a 256"
    else echo "nohash"; return; fi
    { containerfile_text; entrypoint_text; echo "claude=$CLAUDE_VERSION"; } \
        | $hasher | cut -c1-16
}

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
usage() {
    cat <<'EOF_USAGE'
bclaude — Claude Code in a rootless podman container.

USAGE
    bclaude [options] [claude args...]     run Claude Code on a directory
    bclaude [options] <command> [args...]

COMMANDS
    run [args...]     Run Claude Code (default; also used when args are claude flags)
    shell [args...]   Start a shell in the container (`bclaude shell -c 'ls /work'`)
    build             Build/rebuild the container image
    update            Rebuild the image with the newest Claude Code
    doctor            Check that podman and the host are set up correctly
    status            Show image, volumes, credential and workspace state
    install [DIR]     Copy bclaude onto your PATH (default: ~/.local/bin)
    clean [--all]     Remove the image; --all also offers every config volume
                      and the login
    clean --list      List the auth volume and the config volumes with their projects
    clean --prune     Remove per-project volumes whose project directory is gone
    show <part>       Print an embedded file: containerfile | entrypoint
    version           Print the bclaude version
    help              This text

    A command name always wins over a claude subcommand of the same name; use
    `bclaude run <args...>` to force everything through to claude.

OPTIONS
    -w, --workspace DIR   Host directory to mount at /work        (default: $PWD)
    -V, --volume NAME     Named volume holding ~/.claude          (default: bclaude-config)
        --volume-per-project
                          Give each workspace its own config volume, derived from
                          its path, so sessions, MCP servers and project settings
                          don't bleed across repos. The login is not in there —
                          it stays shared. See `bclaude clean --list`
        --auth-volume NAME
                          Volume holding the login, shared by every project
                                                                (default: bclaude-auth)
    -i, --image REF       Image to run                            (default: localhost/bclaude:latest)
        --claude-version V  Claude Code npm version to bake in    (default: latest)
        --ro              Mount the workspace read-only — Claude can read /work
                          but never write to it. Pairs well with -p
        --allow-pkg       Enable `sudo apt-get` inside (relaxes two hardening flags)
        --seed-config     Copy host settings.json + statusline into the container
        --seed-creds      Copy the host's Claude login into the auth volume,
                          replacing any login already there. Off by default: the
                          container logs in on its own, so the host refresh token
                          is never exposed. Also the way to replace a stale token
        --memory SIZE     Memory cap, e.g. 8g; "none" disables    (default: 4g)
        --cpus N          CPU cap; "none" disables                (default: 2)
        --no-limits       Shorthand for --memory none --cpus none
        --rebuild         Rebuild the image before running
        --no-cache        With build/update/--rebuild: ignore the layer cache
        --no-autobuild    Fail instead of building a missing/stale image
        --no-git-config   Don't mount ~/.gitconfig (mounted read-only by default,
                          so `git commit` inside the container knows who you are)
        --allow-root      Permit rootful podman. Refused by default: rootless is
                          what keeps a container escape from becoming host root
        --dry-run         Print the podman command instead of running it
    -h, --help            This text
        --                Stop parsing; everything after goes to claude

    Anything bclaude does not recognise is passed through to claude, so
    `bclaude -p "hi"` and `bclaude --model opus` work as expected.

ENVIRONMENT
    Every option has an env-var equivalent: BCLAUDE_WORKSPACE, BCLAUDE_VOLUME,
    BCLAUDE_AUTH_VOLUME, BCLAUDE_IMAGE, CLAUDE_VERSION, MEMORY, CPUS, TMPFS_SIZE, ALLOW_PKG=1,
    SEED_CONFIG=1, SEED_CREDS=1, BCLAUDE_RO=1, BCLAUDE_VOLUME_PER_PROJECT=1,
    BCLAUDE_AUTOBUILD=0, BCLAUDE_GIT_CONFIG=0, BCLAUDE_ALLOW_ROOT=1. HOST_CREDS
    points at the host credentials file used by --seed-creds.
    ANTHROPIC_API_KEY is forwarded into the container when set.

EXAMPLES
    bclaude                            # session on the current directory
    bclaude -w ~/git/proj              # ... on another directory
    bclaude -p "explain this repo"     # headless prompt
    bclaude shell                      # poke around the container
    bclaude --ro -p "review this"      # read-only session, nothing can be written
    bclaude --volume-per-project       # config volume of its own for this repo
    bclaude clean --list               # which config volumes exist, and for what
    bclaude --allow-pkg                # let Claude apt-get install things
    bclaude doctor                     # diagnose a broken setup
EOF_USAGE
}

# ---------------------------------------------------------------------------
# Preflight checks
# ---------------------------------------------------------------------------
have() { command -v "$1" >/dev/null 2>&1; }

podman_ok=""
require_podman() {
    [ -n "$podman_ok" ] && return 0
    have podman || die "podman is not installed.
  Debian/Ubuntu:  sudo apt-get install -y podman
  Fedora/RHEL:    sudo dnf install -y podman
  Arch:           sudo pacman -S podman
  macOS:          brew install podman && podman machine init && podman machine start"
    podman_ok=1
}

# `podman info` costs seconds, so the hot path never calls it: cgroup and
# rootless state are read straight from the kernel instead. doctor still runs
# the full `podman info` for a real diagnosis.
is_rootless() { [ "$(id -u)" != "0" ]; }

# bclaude's whole security model rests on rootless podman: a container escape
# lands as your unprivileged user, not as root on the host. Running rootful
# throws that away, so it has to be asked for explicitly.
require_rootless() {
    is_rootless && return 0
    [ -n "$ALLOW_ROOT" ] && { warn "running rootful podman as root — container isolation is much weaker"; return 0; }
    die "refusing to run as root.

  bclaude is designed for rootless podman: containers run as your unprivileged
  user, so a container escape cannot become host root, and files written to the
  workspace stay owned by you.

  Run it as your normal user (no sudo). If you really need rootful podman,
  pass --allow-root (or set BCLAUDE_ALLOW_ROOT=1)."
}
cgroups_v2()  { [ -f /sys/fs/cgroup/cgroup.controllers ]; }

# Rootless podman without a delegated memory controller cannot apply
# --memory/--cpus; it errors out rather than ignoring them, so drop the caps
# instead of failing the run.
cgroup_limits_available() {
    cgroups_v2 || return 1
    is_rootless || return 0
    local f
    f="/sys/fs/cgroup/user.slice/user-$(id -u).slice/cgroup.controllers"
    [ -r "$f" ] || return 0          # unknown layout: assume it works
    grep -qw memory "$f"
}

check_cgroups() {
    { [ -n "$MEMORY" ] || [ -n "$CPUS" ]; } || return 0
    if ! cgroup_limits_available; then
        warn "this host cannot enforce rootless memory/cpu limits (needs cgroups v2 with a delegated memory controller) — disabling them"
        MEMORY=""; CPUS=""
    fi
}

check_subid() {
    local user="${USER:-$(id -un)}"
    if [ -r /etc/subuid ] && ! grep -qE "^($user|$(id -u)):" /etc/subuid 2>/dev/null; then
        return 1
    fi
    return 0
}

image_exists() { podman image exists "$IMAGE" 2>/dev/null; }

volume_mountpoint() {   # volume_mountpoint [name]
    podman volume inspect "${1:-$VOLUME}" --format '{{.Mountpoint}}' 2>/dev/null || true
}

volume_has_creds() {    # volume_has_creds [name]
    local mp; mp="$(volume_mountpoint "${1:-$VOLUME}")"
    [ -n "$mp" ] && [ -s "$mp/.credentials.json" ]
}

volume_workspace() {    # the project a per-project volume belongs to, if any
    podman volume inspect "$1" \
        --format "{{index .Labels \"$WORKSPACE_LABEL\"}}" 2>/dev/null || true
}

# You are logged in if the shared auth volume holds a token. A config volume
# from before the split may still hold the only copy; the entrypoint moves it
# into the auth volume on the next run, so count it too.
logged_in() { volume_has_creds "$AUTH_VOLUME" || volume_has_creds "$VOLUME"; }

# Volumes bclaude created are labelled, so listing and pruning them never has to
# guess from names. A volume from before the labels existed still shows up in
# the listing, because the one this run would use is always included.
bclaude_volumes() {   # config volumes only; the auth volume is not one of them
    podman volume ls --filter "label=$ROLE_LABEL=config" --format '{{.Name}}' 2>/dev/null || true
}

all_bclaude_volumes() {
    {
        bclaude_volumes
        if podman volume exists "$VOLUME" 2>/dev/null; then printf '%s\n' "$VOLUME"; fi
    } | sed '/^$/d' | sort -u
}

ensure_volume() {   # ensure_volume <name> <role> [workspace]
    podman volume exists "$1" 2>/dev/null && return 0
    local args=(volume create --label "$VOLUME_LABEL=1" --label "$ROLE_LABEL=$2")
    if [ -n "${3:-}" ]; then args+=(--label "$WORKSPACE_LABEL=$3"); fi
    podman "${args[@]}" "$1" >/dev/null
    info "created $2 volume $1"
}

ensure_volumes() {
    ensure_volume "$AUTH_VOLUME" auth
    if [ -n "$VOLUME_PER_PROJECT" ] && [ -z "$VOLUME_EXPLICIT" ]; then
        ensure_volume "$VOLUME" config "$WORKSPACE"
    else
        ensure_volume "$VOLUME" config
    fi
}

short_hash() {
    local out
    if   have sha256sum; then out="$(printf '%s' "$1" | sha256sum)"
    elif have shasum;    then out="$(printf '%s' "$1" | shasum -a 256)"
    else                      out="$(printf '%s' "$1" | cksum)"
    fi
    printf '%s' "${out%% *}" | cut -c1-8
}

# Per-project volume name: <default>-<directory name>-<hash of the full path>.
# The directory name is there so `podman volume ls` stays readable; the hash is
# what makes it unique, so two repos with the same basename don't collide.
project_volume_name() {
    local path="$1" slug hash
    slug="$(basename -- "$path" | tr -c 'A-Za-z0-9._' '-' | sed -e 's/^-*//' -e 's/-*$//')"
    slug="$(printf '%.24s' "$slug")"
    hash="$(short_hash "$path")"
    if [ -n "$slug" ]; then printf '%s-%s-%s\n' "$VOLUME_DEFAULT" "$slug" "$hash"
    else                    printf '%s-%s\n'    "$VOLUME_DEFAULT" "$hash"
    fi
}

# Decide which config volume this run uses. Call once the workspace path is
# canonical, so the derived name is stable no matter how you spelled the path.
resolve_volume() {
    [ -n "$VOLUME_PER_PROJECT" ] || return 0
    if [ -n "$VOLUME_EXPLICIT" ]; then
        warn "--volume-per-project ignored: volume '$VOLUME' was named explicitly"
        return 0
    fi
    VOLUME="$(project_volume_name "$WORKSPACE")"
}

# Credentials are not seeded from the host by default, so a fresh volume means a
# login inside the container. Say so up front rather than letting the login
# prompt appear unexplained — and refuse to pretend a headless run will work.
first_login_hint() {
    local a headless=""
    for a in "$@"; do
        case "$a" in -p|--print) headless=1; break ;; esac
    done
    if [ -n "$headless" ]; then
        warn "no login in volume '$AUTH_VOLUME' and no ANTHROPIC_API_KEY — a headless run has no way to log in.
  Run 'bclaude' once interactively to log in, or pass --seed-creds to copy your host login into the volume."
    else
        info "no login in volume '$AUTH_VOLUME' yet — Claude will ask you to log in inside the container"
        info "that is a one-time step for all your projects; the login is stored there, not on your host"
        if [ -s "$HOST_CREDS" ]; then
            info "to reuse your host login instead, re-run with --seed-creds"
        fi
    fi
    return 0
}

image_recipe() {
    podman image inspect "$IMAGE" \
        --format "{{index .Labels \"$RECIPE_LABEL\"}}" 2>/dev/null || true
}

image_is_current() { [ "$(image_recipe)" = "$(recipe_hash)" ]; }

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
do_build() {
    require_podman
    require_rootless
    local ctx
    ctx="$(mktemp -d "${TMPDIR:-/tmp}/bclaude-build.XXXXXX")"
    # shellcheck disable=SC2064
    trap "rm -rf '$ctx'" EXIT
    containerfile_text > "$ctx/Containerfile"
    entrypoint_text    > "$ctx/entrypoint.sh"
    chmod 0755 "$ctx/entrypoint.sh"

    local build_args=(
        build
        --tag "$IMAGE"
        --build-arg "CLAUDE_VERSION=$CLAUDE_VERSION"
        --label "$RECIPE_LABEL=$(recipe_hash)"
        --label "org.bclaude.version=$BCLAUDE_VERSION"
        --file "$ctx/Containerfile"
    )
    [ -n "$NO_CACHE" ] && build_args+=(--no-cache)
    build_args+=("$ctx")

    if [ -n "$DRY_RUN" ]; then
        printf 'podman'; printf ' %q' "${build_args[@]}"; printf '\n'
        return 0
    fi

    info "building $IMAGE (claude-code@$CLAUDE_VERSION) — this takes a few minutes"
    podman "${build_args[@]}" >&2 || die "image build failed"
    info "${C_GRN}built${C_OFF} $IMAGE"
}

ensure_image() {
    [ -n "$DRY_RUN" ] && return 0
    if [ -n "$FORCE_REBUILD" ]; then do_build; return; fi
    if ! image_exists; then
        [ "$AUTOBUILD" = "1" ] || die "image '$IMAGE' does not exist. Run 'bclaude build'."
        info "image '$IMAGE' not found — building it once"
        do_build
        return
    fi
    if ! image_is_current; then
        if [ "$AUTOBUILD" = "1" ]; then
            info "image is older than this script — rebuilding"
            do_build
        else
            warn "image '$IMAGE' was built from a different bclaude recipe; run 'bclaude build'."
        fi
    fi
}

# ---------------------------------------------------------------------------
# Run
# ---------------------------------------------------------------------------
do_run() {
    require_podman
    require_rootless
    [ -d "$WORKSPACE" ] || die "workspace '$WORKSPACE' is not a directory"
    WORKSPACE="$(cd "$WORKSPACE" && pwd)"
    [ "$WORKSPACE" = "$HOME" ] && warn "workspace is your entire home directory — the container will see all of it"
    if [ "$WORKSPACE" = "/" ]; then
        die "refusing to mount / as the workspace"
    fi

    resolve_volume
    check_cgroups
    ensure_image

    if [ -z "$DRY_RUN" ]; then ensure_volumes; fi

    # --ro: /work goes in read-only, so an analysis or review session cannot
    # touch the project at all. Everything Claude needs to write during a run
    # (the config volume, /tmp) is elsewhere, so this is a working setup.
    local ws_opts=""
    if [ -n "$READONLY_WORKSPACE" ]; then
        ws_opts="$(mount_opts ro)"
        info "workspace mounted read-only"
    else
        ws_opts="$(mount_opts)"
    fi

    local run_args=(
        run --rm
        --hostname bclaude
        # Map the host user onto the image's claude user (uid/gid 1000) rather
        # than onto its own numeric id. Plain keep-id maps the caller to the same
        # number inside, which for any host uid other than 1000 leaves the
        # process (still uid 1000, from the image's USER) unable to write a
        # workspace owned by the caller.
        "--userns=keep-id:uid=$CONTAINER_UID,gid=$CONTAINER_GID"
        --pids-limit 2048
        --volume "$WORKSPACE:/work$ws_opts"
        --volume "$VOLUME:/home/claude/.claude$(mount_opts)"
        --volume "$AUTH_VOLUME:$AUTH_DIR$(mount_opts)"
        --workdir /work
        --env "TERM=${TERM:-xterm-256color}"
        --env "COLORTERM=${COLORTERM:-truecolor}"
        # Fresh nosuid tmpfs /tmp: no dropped setuid binary can be executed from
        # it, and it's wiped each run. exec is kept so build tools can run there.
        --tmpfs "/tmp:rw,nosuid,nodev,exec,size=$TMPFS_SIZE"
    )

    # Only ask for a TTY when we actually have one, so CI and pipelines work.
    [ -t 0 ] && run_args+=(--interactive --tty)

    # Resource limits. Caps blast radius of a runaway/hostile process; the
    # pids-limit above only stops fork bombs. --memory-swap == --memory disables
    # swap growth.
    [ -n "$MEMORY" ] && run_args+=(--memory "$MEMORY" --memory-swap "$MEMORY")
    [ -n "$CPUS" ]   && run_args+=(--cpus "$CPUS")

    # Hardening. --allow-pkg relaxes the two flags that block `sudo apt-get`:
    # no-new-privileges (blocks the setuid escalation) and cap-drop=ALL (dpkg
    # needs CHOWN/DAC_OVERRIDE etc.). Installs land in the container's throwaway
    # layer; the userns mapping means Claude's /work edits still come out owned
    # by you.
    if [ -n "$ALLOW_PKG" ]; then
        warn "--allow-pkg: sudo apt enabled inside the container, hardening relaxed"
    else
        run_args+=(--security-opt no-new-privileges --cap-drop=ALL)
    fi

    # Credential seeding is opt-in. By default the host's OAuth refresh token is
    # never exposed to the container, not even once: you log in inside instead,
    # and that login lives in the auth volume. --seed-creds mounts the host
    # file read-only as a seed source, and the entrypoint copies it in — every
    # time it is passed, so it doubles as the fix for a token that went stale.
    if [ -n "$SEED_CREDS" ]; then
        if [ -s "$HOST_CREDS" ]; then
            run_args+=(--volume "$HOST_CREDS:/run/host-claude/.credentials.json$(mount_opts ro)")
        else
            warn "--seed-creds: no host credentials at $HOST_CREDS — you'll log in inside the container"
        fi
    elif [ -z "${ANTHROPIC_API_KEY:-}" ] && [ -z "$DRY_RUN" ] && ! logged_in; then
        first_login_hint "$@"
    fi

    # --seed-config pulls host settings.json (statusline, model, tui) and the
    # statusline script into the container, rewriting host paths. Each is mounted
    # read-only as a seed source; the entrypoint copies + rewrites.
    if [ -n "$SEED_CONFIG" ]; then
        run_args+=(--env "HOST_HOME=$HOME")
        local f
        for f in settings.json statusline-command.sh; do
            [ -s "$HOME/.claude/$f" ] && \
                run_args+=(--volume "$HOME/.claude/$f:/run/host-claude/$f$(mount_opts ro)")
        done
    fi

    # Your git identity, read-only. Without it every `git commit` Claude makes
    # inside the container fails with "please tell me who you are".
    if [ "$GIT_CONFIG_MOUNT" = "1" ] && [ -s "$HOME/.gitconfig" ]; then
        run_args+=(--volume "$HOME/.gitconfig:/home/claude/.gitconfig$(mount_opts ro)")
    fi

    # Optional: forward an API key instead of / alongside the subscription creds.
    # Named without a value, so podman imports it from our own environment: the
    # key never reaches podman's argv, where `ps` on a shared host would show it
    # and where --dry-run output would print it for pasting into a bug report.
    if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
        run_args+=(--env ANTHROPIC_API_KEY)
    fi

    run_args+=("$IMAGE" "$@")

    if [ -n "$DRY_RUN" ]; then
        printf 'podman'; printf ' %q' "${run_args[@]}"; printf '\n'
        return 0
    fi
    exec podman "${run_args[@]}"
}

# ---------------------------------------------------------------------------
# doctor / status / clean
# ---------------------------------------------------------------------------
doctor_fail=0
ok()    { printf '  %s✓%s %s\n' "$C_GRN" "$C_OFF" "$*"; }
bad()   { printf '  %s✗%s %s\n' "$C_RED" "$C_OFF" "$*"; doctor_fail=1; }
note()  { printf '  %s•%s %s\n' "$C_YEL" "$C_OFF" "$*"; }

do_doctor() {
    printf 'bclaude %s — environment check\n\n' "$BCLAUDE_VERSION"

    if have podman; then
        ok "podman found: $(podman --version 2>/dev/null)"
    else
        bad "podman not installed (apt-get/dnf/pacman install podman, or brew on macOS)"
        printf '\n%sCannot continue without podman.%s\n' "$C_RED" "$C_OFF"
        return 1
    fi

    local info rootless cgroups
    if info="$(podman info --format '{{.Host.Security.Rootless}} {{.Host.CgroupsVersion}}' 2>&1)"; then
        ok "podman is functional"
    else
        bad "\`podman info\` fails — podman is installed but not usable:"
        printf '%s\n' "$info" | sed 's/^/      /' | head -n 10
        return 1
    fi
    rootless="${info%% *}"
    cgroups="${info##* }"
    if [ "$rootless" = "true" ]; then
        ok "running rootless (uid $(id -u))"
    elif [ -n "$ALLOW_ROOT" ]; then
        note "rootful podman, allowed via --allow-root — isolation is much weaker"
    else
        bad "rootful podman (uid $(id -u)) — bclaude requires rootless podman so a container escape cannot become host root. Run as your normal user, or pass --allow-root to override."
    fi

    if cgroup_limits_available; then ok "cgroups $cgroups — memory/cpu limits enforceable"
    else note "cgroups $cgroups without a delegated memory controller — memory/cpu limits will be skipped"; fi

    if [ "$rootless" = "true" ]; then
        if check_subid; then ok "subuid/subgid mapping present for ${USER:-$(id -un)}"
        else bad "no /etc/subuid entry for ${USER:-$(id -un)} — run: sudo usermod --add-subuids 100000-165535 --add-subgids 100000-165535 ${USER:-$(id -un)} && podman system migrate"; fi
    fi

    if have newuidmap; then ok "newuidmap/newgidmap available"
    else note "newuidmap not found (package: uidmap) — --userns=keep-id may fail"; fi

    if [ "$(id -u)" != "$CONTAINER_UID" ] && [ "$rootless" = "true" ]; then
        ok "your uid is $(id -u), not $CONTAINER_UID — mapped onto the container's claude user ($CONTAINER_UID) so /work stays writable"
    fi

    # SELinux relabelling is needed for bind mounts on Fedora/RHEL.
    if have getenforce && [ "$(getenforce 2>/dev/null)" = "Enforcing" ]; then
        ok "SELinux enforcing — bind mounts get the :z relabel automatically"
    fi

    if image_exists; then
        if image_is_current; then ok "image $IMAGE present and up to date"
        else note "image $IMAGE is stale (built from a different bclaude) — will rebuild on next run"; fi
    else
        note "image $IMAGE not built yet — the first run builds it (or run 'bclaude build')"
    fi

    if [ -d "$WORKSPACE" ]; then WORKSPACE="$(cd "$WORKSPACE" && pwd)"; fi
    resolve_volume
    if [ -n "$VOLUME_PER_PROJECT" ]; then
        ok "--volume-per-project: this workspace uses config volume '$VOLUME'"
    fi
    if podman volume exists "$VOLUME" 2>/dev/null; then ok "config volume '$VOLUME' exists"
    else note "config volume '$VOLUME' will be created on first run"; fi

    if [ -n "$SEED_CREDS" ] && [ -s "$HOST_CREDS" ]; then
        ok "--seed-creds: $HOST_CREDS will be copied into volume '$AUTH_VOLUME' on the next run"
    elif logged_in; then ok "logged in — the token is in the shared auth volume '$AUTH_VOLUME'"
    elif [ -n "${ANTHROPIC_API_KEY:-}" ]; then ok "ANTHROPIC_API_KEY is set and will be forwarded"
    elif [ -s "$HOST_CREDS" ]; then
        note "no login yet — the first run logs in inside the container (host credentials exist at $HOST_CREDS but are only used if you pass --seed-creds)"
    else note "no login yet and no ANTHROPIC_API_KEY — you'll log in inside the container"; fi

    if [ -d "$WORKSPACE" ]; then ok "workspace $WORKSPACE"
    else bad "workspace '$WORKSPACE' is not a directory"; fi

    printf '\n'
    if [ "$doctor_fail" = "0" ]; then
        printf '%sReady.%s Run `bclaude` in a project directory.\n' "$C_GRN" "$C_OFF"
    else
        printf '%sProblems found — see the ✗ lines above.%s\n' "$C_RED" "$C_OFF"
    fi
    return "$doctor_fail"
}

do_status() {
    require_podman
    printf 'bclaude %s\n' "$BCLAUDE_VERSION"
    if [ -d "$WORKSPACE" ]; then WORKSPACE="$(cd "$WORKSPACE" && pwd)"; fi
    resolve_volume
    local ws_note=""
    [ -n "$READONLY_WORKSPACE" ] && ws_note=" (read-only)"
    printf '  workspace : %s%s\n' "$WORKSPACE" "$ws_note"
    printf '  image     : %s' "$IMAGE"
    if image_exists; then
        printf ' (%s, %s)\n' \
            "$(podman image inspect "$IMAGE" --format '{{.Created}}' 2>/dev/null | cut -c1-10)" \
            "$(image_is_current && echo up-to-date || echo stale)"
    else
        printf ' (not built)\n'
    fi
    printf '  volume    : %s%s\n' "$VOLUME" \
        "$(podman volume exists "$VOLUME" 2>/dev/null && echo '' || echo ' (not created)')"
    printf '  auth      : %s%s\n' "$AUTH_VOLUME" \
        "$(podman volume exists "$AUTH_VOLUME" 2>/dev/null && echo '' || echo ' (not created)')"
    local creds="no (logs in inside the container on first run)"
    logged_in && creds="yes"
    [ -n "$SEED_CREDS" ] && [ -s "$HOST_CREDS" ] && \
        creds="$creds; --seed-creds copies $HOST_CREDS in"
    printf '  logged in : %s\n' "$creds"
    printf '  limits    : memory=%s cpus=%s\n' "${MEMORY:-none}" "${CPUS:-none}"
}

# Copy this script somewhere on PATH so it works from any directory.
#
# Also supports the piped install, where there is no script file to copy:
#   curl -fsSL <raw url>/bclaude | bash -s -- install
# In that case the script is fetched from BCLAUDE_URL instead.
do_install() {
    local dest="${1:-$HOME/.local/bin}"
    local self="" src="${BASH_SOURCE[0]:-}"
    if [ -f "$src" ]; then
        self="$(cd "$(dirname "$src")" && pwd)/$(basename "$src")"
    fi

    mkdir -p "$dest" || die "could not create $dest"

    if [ -n "$self" ]; then
        if [ "$self" = "$dest/bclaude" ]; then
            info "already installed at $dest/bclaude"
            return 0
        fi
        install -m 0755 "$self" "$dest/bclaude" || die "could not install to $dest"
    else
        # Piped from curl: no file on disk, so fetch a copy.
        local tmp; tmp="$(mktemp "${TMPDIR:-/tmp}/bclaude.XXXXXX")"
        # shellcheck disable=SC2064
        trap "rm -f '$tmp'" EXIT
        info "downloading $BCLAUDE_URL"
        if have curl; then
            curl -fsSL "$BCLAUDE_URL" -o "$tmp" || die "download failed: $BCLAUDE_URL"
        elif have wget; then
            wget -qO "$tmp" "$BCLAUDE_URL" || die "download failed: $BCLAUDE_URL"
        else
            die "need curl or wget to install from a pipe; download bclaude manually instead"
        fi
        # Refuse to install a truncated or wrong file.
        head -n 1 "$tmp" | grep -q '^#!/usr/bin/env bash' \
            || die "downloaded file is not the bclaude script"
        grep -q '^BCLAUDE_VERSION=' "$tmp" || die "downloaded file looks incomplete"
        bash -n "$tmp" 2>/dev/null || die "downloaded file does not parse — refusing to install"
        install -m 0755 "$tmp" "$dest/bclaude" || die "could not install to $dest"
    fi

    info "${C_GRN}installed${C_OFF} $dest/bclaude"
    case ":$PATH:" in
        *":$dest:"*) info "run 'bclaude doctor' to check your setup" ;;
        *) warn "$dest is not on your PATH — add this to your shell rc:
    export PATH=\"$dest:\$PATH\"" ;;
    esac
}

# `clean --list`: what config volumes exist, whose project each belongs to and
# whether it holds a login. The volume this invocation would use is starred.
list_volumes() {
    local vols v ws mark state="no login yet"
    volume_has_creds "$AUTH_VOLUME" && state="logged in"
    if podman volume exists "$AUTH_VOLUME" 2>/dev/null; then
        printf '  auth volume  %s (%s)\n\n' "$AUTH_VOLUME" "$state"
    else
        printf '  auth volume  %s (not created yet)\n\n' "$AUTH_VOLUME"
    fi

    vols="$(all_bclaude_volumes)"
    if [ -z "$vols" ]; then
        info "no bclaude config volumes yet"
        return 0
    fi
    printf '  %-44s %s\n' "CONFIG VOLUME" "PROJECT"
    while IFS= read -r v; do
        [ -n "$v" ] || continue
        ws="$(volume_workspace "$v")"
        mark=" "; [ "$v" = "$VOLUME" ] && mark="*"
        if   [ -z "$ws" ];    then ws="(shared)"
        elif [ ! -d "$ws" ];  then ws="$ws  ← gone"
        fi
        printf '%s %-44s %s\n' "$mark" "$v" "$ws"
    done <<< "$vols"
    printf '\n  * = the volume this invocation would use\n'
    printf '  bclaude clean --prune removes the ones whose project is gone\n'
}

# `clean --prune`: drop per-project volumes whose project directory no longer
# exists. Only labelled per-project volumes qualify — a shared volume has no
# project to disappear, so it is never touched.
prune_volumes() {
    local yes="" v ws gone=()
    case "${1:-}" in -y|--yes) yes=1 ;; esac
    while IFS= read -r v; do
        [ -n "$v" ] || continue
        ws="$(volume_workspace "$v")"
        [ -n "$ws" ] || continue
        [ -d "$ws" ] && continue
        [ "$v" = "$VOLUME" ] && continue
        [ "$v" = "$AUTH_VOLUME" ] && continue
        gone+=("$v")
    done < <(bclaude_volumes)

    if [ "${#gone[@]}" -eq 0 ]; then
        info "nothing to prune — every per-project volume still has its project directory"
        return 0
    fi
    printf 'Per-project config volumes whose project directory is gone:\n' >&2
    for v in "${gone[@]}"; do
        printf '  %s  (%s)\n' "$v" "$(volume_workspace "$v")" >&2
    done
    if [ -z "$yes" ]; then
        printf 'Remove them (sessions + project settings; your login is elsewhere)? [y/N] ' >&2
        local reply; read -r reply || reply=""
        case "$reply" in
            [yY]*) ;;
            *) info "kept ${#gone[@]} volume(s)"; return 0 ;;
        esac
    fi
    for v in "${gone[@]}"; do
        podman volume rm "$v" >/dev/null && info "removed volume $v"
    done
}

do_clean() {
    require_podman
    if [ -d "$WORKSPACE" ]; then WORKSPACE="$(cd "$WORKSPACE" && pwd)"; fi
    resolve_volume
    case "${1:-}" in
        --list)  list_volumes; return 0 ;;
        --prune) shift; prune_volumes "$@"; return 0 ;;
    esac
    local all=""
    [ "${1:-}" = "--all" ] && all=1
    if image_exists; then
        podman rmi -f "$IMAGE" >/dev/null && info "removed image $IMAGE"
    else
        info "image $IMAGE not present"
    fi
    if [ -n "$all" ]; then
        # --all means all of them: with --volume-per-project there is a config
        # volume per repo, and removing only the one for the current directory
        # would leave the rest behind while claiming to have cleaned up. They
        # are named before the prompt so nobody deletes a project's sessions
        # without seeing it coming. The login is asked for separately: it is a
        # different kind of loss.
        local vols v ws reply
        vols="$(all_bclaude_volumes)"
        if [ -n "$vols" ]; then
            printf 'Config volumes to remove (sessions + project settings):\n' >&2
            while IFS= read -r v; do
                ws="$(volume_workspace "$v")"
                printf '  %s%s\n' "$v" "${ws:+  ($ws)}" >&2
            done <<< "$vols"
            printf 'Remove them? [y/N] ' >&2
            read -r reply || reply=""
            case "$reply" in
                [yY]*) while IFS= read -r v; do
                           podman volume rm "$v" >/dev/null && info "removed volume $v"
                       done <<< "$vols" ;;
                *) info "kept the config volumes" ;;
            esac
        fi
        if podman volume exists "$AUTH_VOLUME" 2>/dev/null; then
            printf 'Remove auth volume %s (logs you out of every project)? [y/N] ' "$AUTH_VOLUME" >&2
            read -r reply || reply=""
            case "$reply" in
                [yY]*) podman volume rm "$AUTH_VOLUME" >/dev/null && info "removed volume $AUTH_VOLUME" ;;
                *) info "kept volume $AUTH_VOLUME" ;;
            esac
        fi
    else
        info "config volumes and auth volume $AUTH_VOLUME kept (use 'bclaude clean --all' to remove them, 'bclaude clean --list' to see them)"
    fi
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
# bclaude options are recognised only until the first thing we don't own; from
# there on everything is handed to claude untouched.
parse_opts() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -w|--workspace) WORKSPACE="${2:?--workspace needs a directory}"; shift 2 ;;
            -V|--volume)    VOLUME="${2:?--volume needs a name}"; VOLUME_EXPLICIT=1; shift 2 ;;
            -i|--image)     IMAGE="${2:?--image needs a reference}"; shift 2 ;;
            --claude-version) CLAUDE_VERSION="${2:?--claude-version needs a value}"; shift 2 ;;
            --memory)       MEMORY="${2:?--memory needs a value}"; [ "$MEMORY" = none ] && MEMORY=""; shift 2 ;;
            --cpus)         CPUS="${2:?--cpus needs a value}"; [ "$CPUS" = none ] && CPUS=""; shift 2 ;;
            --no-limits)    MEMORY=""; CPUS=""; shift ;;
            --volume-per-project) VOLUME_PER_PROJECT=1; shift ;;
            --auth-volume)  AUTH_VOLUME="${2:?--auth-volume needs a name}"; shift 2 ;;
            --ro|--read-only) READONLY_WORKSPACE=1; shift ;;
            --allow-pkg)    ALLOW_PKG=1; shift ;;
            --seed-config)  SEED_CONFIG=1; shift ;;
            --seed-creds)   SEED_CREDS=1; shift ;;
            --rebuild)      FORCE_REBUILD=1; shift ;;
            --no-cache)     NO_CACHE=1; shift ;;
            --no-autobuild) AUTOBUILD=0; shift ;;
            --no-git-config) GIT_CONFIG_MOUNT=0; shift ;;
            --allow-root)   ALLOW_ROOT=1; shift ;;
            --dry-run)      DRY_RUN=1; shift ;;
            -h|--help)      usage; exit 0 ;;
            --version)      echo "bclaude $BCLAUDE_VERSION"; exit 0 ;;
            --)             shift; break ;;
            *)              break ;;
        esac
    done
    REST=("$@")
}

main() {
    parse_opts "$@"
    set -- ${REST[@]+"${REST[@]}"}

    # SELinux systems need the relabel option on bind mounts; mount_opts adds it.
    SELINUX_RELABEL=""
    if have getenforce && [ "$(getenforce 2>/dev/null)" = "Enforcing" ]; then
        SELINUX_RELABEL=1
    fi

    case "${1:-}" in
        help)    usage ;;
        version) echo "bclaude $BCLAUDE_VERSION" ;;
        doctor)  do_doctor ;;
        status)  do_status ;;
        build)   do_build ;;
        update)  CLAUDE_VERSION="latest"; NO_CACHE=1; do_build ;;
        clean)   shift; do_clean "$@" ;;
        install) shift; do_install "$@" ;;
        show)
            case "${2:-}" in
                containerfile) containerfile_text ;;
                entrypoint)    entrypoint_text ;;
                *) die "show what? try: bclaude show containerfile | bclaude show entrypoint" ;;
            esac ;;
        shell)   shift; do_run bash "$@" ;;
        run)     shift; do_run "$@" ;;
        *)       do_run "$@" ;;
    esac
}

main "$@"
