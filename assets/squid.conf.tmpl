# Generated by aibox — do not edit; edit the allowlist fragments instead and
# run 'aibox egress reload'.
http_port {{.Port}}
visible_hostname {{.ProxyName}}

# The audit trail: one line per request on stdout -> podman logs.
access_log stdio:/dev/stdout
cache deny all
shutdown_lifetime 1 seconds

# Only the internal network may use the proxy.
acl aibox_clients src {{.Subnet}}
acl allowed dstdomain "{{.AllowlistPath}}"
acl CONNECT method CONNECT

# The domain allowlist is the enforcement — not the port. Ports are
# deliberately unrestricted so an allowlisted host works on whatever port it
# actually serves (an internal API on :8443, a registry on :5000, a database
# over TLS, plain http on :80). A host you did not allow is still denied on
# every port. Deny-by-default: only allowlisted domains, from the internal
# network, get out — on any port.
http_access allow aibox_clients allowed
http_access deny all
