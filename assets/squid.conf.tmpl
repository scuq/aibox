# Generated by aibox — do not edit; edit the allowlist fragments instead and
# run 'aibox egress reload'.
http_port {{.Port}}
visible_hostname {{.ProxyName}}

# The audit trail: one line per request on stdout -> podman logs.
access_log stdio:/dev/stdout
cache deny all
shutdown_lifetime 1 seconds

# Only the internal network may use the proxy.
acl aibox_clients src {{.Subnet}}
acl allowed dstdomain "{{.AllowlistPath}}"
acl SSL_ports port 443
acl Safe_ports port 80 443
acl CONNECT method CONNECT

# Deny-by-default: only CONNECT to :443 and plain http to :80 for domains in
# the allowlist.
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow aibox_clients allowed
http_access deny all
