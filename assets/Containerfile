# aibox image recipe. Built by `aibox image build`; every non-obvious line
# carries the reason it exists, ported from bclaude — do not remove a
# hardening flag or workaround without recording why it is safe to.
FROM docker.io/library/node:22-bookworm-slim

# Pin these to specific versions for a reproducible image; "latest" floats.
ARG CLAUDE_VERSION=latest
ARG CODEX_VERSION=latest

# Three groups in one layer: what the assistant CLIs themselves need, what
# makes this a dev environment rather than just a runtime, and the repository
# *read* toolbox (ripgrep, fd, bat, fzf, tree) the agent is told to prefer in
# .ainotes. build-essential + python3-dev are what let a pip install with a
# native extension compile instead of dying halfway; python-is-python3 is
# there because half the tooling in the world still calls `python`.
# fd-find installs as `fdfind` and bat as `batcat` on Debian; both get their
# real names below so the agent-facing docs can say `fd` and `bat`.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        openssl \
        curl \
        git \
        jq \
        less \
        openssh-client \
        procps \
        ripgrep \
        fd-find \
        bat \
        fzf \
        tree \
        expect \
        netcat-openbsd \
        tar \
        bzip2 \
        sudo \
        unzip \
        build-essential \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python-is-python3 \
        lua5.4 \
        liblua5.4-dev \
        luarocks \
        libicu72 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(command -v fdfind)" /usr/local/bin/fd \
    && ln -s "$(command -v batcat)" /usr/local/bin/bat \
    && ln -s "$(command -v lua5.4)" /usr/local/bin/lua
# netcat-openbsd is named explicitly (plain "netcat" is a virtual package and
# apt would pick an arbitrary provider; the openbsd one is the `nc` everyone's
# examples assume). tar is Essential in Debian and always present — listed
# anyway for the same reason as openssl: tools the agent relies on are named,
# not inherited. bzip2 is genuinely absent from slim images.
# lua5.4 installs only a versioned binary; the symlink gives scripts and the
# agent the name they expect. liblua5.4-dev is what lets luarocks compile
# rocks with native parts. libicu72 is not for lua — it is PowerShell's one
# hard runtime dependency on Debian (installed further down from a tarball,
# which cannot pull it in itself). openssl (the CLI) is listed explicitly
# even though ca-certificates happens to depend on it today: relying on a
# transitive dependency for a tool the agent is expected to use is how it
# silently vanishes in a base-image bump.

# Custom CA certificates, e.g. a corporate root or a TLS-inspecting proxy's
# CA. The build context always contains a ca-certificates/ directory; aibox
# fills it from image.caCertificates (or --ca-certs / AIBOX_CA_CERTS) and it
# is empty otherwise, which makes this block a no-op. Placed *before* every
# toolchain download below, so those downloads work behind an intercepting
# proxy too. update-ca-certificates only picks up *.crt files — aibox
# normalises .pem to .crt when filling the context.
COPY ca-certificates/ /usr/local/share/ca-certificates/aibox/
RUN update-ca-certificates

# Debian marks its system Python "externally managed" (PEP 668), which makes
# even `pip install --user` refuse. That marker guards a machine whose Python
# is an OS dependency; here the container is disposable, /usr is unwritable
# without --allow-pkg anyway, and the only thing the marker achieves is a wall
# in front of the obvious command. Removed — `python3 -m venv` and `uv` are
# still the better habit, and the tooling below is installed where it cannot
# collide.
RUN rm -f /usr/lib/python3*/EXTERNALLY-MANAGED

# Python tooling that is not a project dependency lives in its own venv, so it
# can never fight a project's requirements. Only the entry points are linked
# onto PATH — deliberately not python/pip, so `pip install` still means the
# system interpreter and this venv stays an implementation detail.
RUN python3 -m venv /opt/pytools \
    && /opt/pytools/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/pytools/bin/pip install --no-cache-dir \
        uv \
        ruff \
        mypy \
        pytest \
        ipython \
    && for t in uv uvx ruff mypy pytest ipython; do \
           ln -sf "/opt/pytools/bin/$t" "/usr/local/bin/$t"; \
       done

# Ansible gets a venv of its own, separate from /opt/pytools, for the same
# isolation reason and one more: ansible-core's dependency pins (jinja2,
# resolvelib) are exactly the kind of thing that fights other Python tooling.
# ansible-core rather than the full `ansible` bundle — the bundle is hundreds
# of MB of collections; `ansible-galaxy collection install` fetches what a
# project actually needs, and ANSIBLE_HOME (set below) lands those in the
# cache volume so they survive ephemeral runs. galaxy.ansible.com is in the
# base egress allowlist for exactly that.
RUN python3 -m venv /opt/ansible \
    && /opt/ansible/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/ansible/bin/pip install --no-cache-dir \
        ansible-core \
        ansible-lint \
    && for t in ansible ansible-playbook ansible-galaxy ansible-doc \
                ansible-vault ansible-config ansible-inventory \
                ansible-console ansible-pull ansible-lint; do \
           ln -sf "/opt/ansible/bin/$t" "/usr/local/bin/$t"; \
       done

# Go from upstream: Debian's toolchain trails by a release and splits across
# packages. The version and the two checksums travel together — bump all three
# or the download fails closed. Only the architectures aibox itself runs on
# are pinned; anything else stops the build rather than skipping the
# toolchain. A go.mod asking for a newer toolchain still gets one at run time
# (GOTOOLCHAIN defaults to auto): it comes through the module proxy, is
# checked against the checksum database, and lands in the cache volume like
# any other module.
ARG GO_VERSION=1.26.5
ARG GO_SHA256_AMD64=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053
ARG GO_SHA256_ARM64=fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49
RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) sha="$GO_SHA256_AMD64" ;; \
        arm64) sha="$GO_SHA256_ARM64" ;; \
        *) echo "no pinned Go tarball for $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz"; \
    echo "$sha  /tmp/go.tgz" | sha256sum -c -; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm -f /tmp/go.tgz; \
    /usr/local/go/bin/go version

# The tools the VS Code Go extension expects. Baked in because the alternative
# is the extension running `go install` on first open — which needs a module
# proxy the egress allowlist may not have, into a GOPATH that is a cache.
# These float on @latest; the toolchain above is what is pinned.
# GOFLAGS=-trimpath keeps the build path out of the binaries; the build caches
# are discarded so they don't ride along in the layer.
RUN set -eu; \
    export PATH="/usr/local/go/bin:$PATH" \
           GOPATH=/tmp/gobuild GOBIN=/usr/local/go-tools/bin GOFLAGS=-trimpath; \
    go install golang.org/x/tools/gopls@latest; \
    go install golang.org/x/tools/cmd/goimports@latest; \
    go install github.com/go-delve/delve/cmd/dlv@latest; \
    go install honnef.co/go/tools/cmd/staticcheck@latest; \
    rm -rf /tmp/gobuild /root/.cache/go-build

# yq — the YAML counterpart of jq. mikefarah's Go binary, not Debian's `yq`
# package: that one is the older Python wrapper with a different expression
# syntax, and the agent-facing docs say `yq` meaning this one. A single
# static binary, so it is downloaded and pinned like the toolchains.
ARG YQ_VERSION=4.53.3
ARG YQ_SHA256_AMD64=fa52a4e758c63d38299163fbdd1edfb4c4963247918bf9c1c5d31d84789eded4
ARG YQ_SHA256_ARM64=578648e463a11c1b6db6010cbf41eafed6bee79466fcffa1bb446672cf7945ea
RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) sha="$YQ_SHA256_AMD64" ;; \
        arm64) sha="$YQ_SHA256_ARM64" ;; \
        *) echo "no pinned yq binary for $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/yq "https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_linux_${arch}"; \
    echo "$sha  /usr/local/bin/yq" | sha256sum -c -; \
    chmod 0755 /usr/local/bin/yq; \
    /usr/local/bin/yq --version

# The OpenShift CLI, from Red Hat's mirror — same rules as the Go toolchain:
# version and per-arch checksums travel together, bump all three or the
# download fails closed, and an unpinned architecture stops the build. The
# tarball also ships the matching kubectl, so both come from one download.
# Note the mirror splits by arch *directory* (x86_64/aarch64) while naming
# the tarball identically — the two checksums really do belong to different
# files.
ARG OC_VERSION=4.22.8
ARG OC_SHA256_AMD64=22cb5df5206569ca2c8ca3b56f55f5af9dbd68fc35ea237a4069e06ffd6e9218
ARG OC_SHA256_ARM64=c995389c196b3b085489fa21d6bf02f06a2590b2894fce46c9fd7ce588f10820
RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) mirror_arch=x86_64;  sha="$OC_SHA256_AMD64" ;; \
        arm64) mirror_arch=aarch64; sha="$OC_SHA256_ARM64" ;; \
        *) echo "no pinned oc tarball for $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/oc.tgz "https://mirror.openshift.com/pub/openshift-v4/${mirror_arch}/clients/ocp/${OC_VERSION}/openshift-client-linux-${OC_VERSION}.tar.gz"; \
    echo "$sha  /tmp/oc.tgz" | sha256sum -c -; \
    tar -C /usr/local/bin -xzf /tmp/oc.tgz oc kubectl; \
    rm -f /tmp/oc.tgz; \
    /usr/local/bin/oc version --client

# PowerShell, from the upstream release tarball rather than Microsoft's apt
# repo: the repo only publishes amd64 debs, and this image is also built for
# arm64. Same pin-and-checksum rules. Unpacked under /opt with only the
# entry point linked, so its bundled .NET runtime stays out of everyone
# else's way; libicu72 (its one system dependency) is installed with the
# base packages above.
ARG PWSH_VERSION=7.6.4
ARG PWSH_SHA256_AMD64=4471b5a36bfe86ec7af8525d36bb1cacba0128e7aac22d05cc064bc00e604721
ARG PWSH_SHA256_ARM64=d4ef2382fa452f2ccbdb48a01adbbce9ed64954872123970c16be6d086d1224b
RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) pwsh_arch=x64;   sha="$PWSH_SHA256_AMD64" ;; \
        arm64) pwsh_arch=arm64; sha="$PWSH_SHA256_ARM64" ;; \
        *) echo "no pinned powershell tarball for $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/pwsh.tgz "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell-${PWSH_VERSION}-linux-${pwsh_arch}.tar.gz"; \
    echo "$sha  /tmp/pwsh.tgz" | sha256sum -c -; \
    mkdir -p /opt/powershell; \
    tar -C /opt/powershell -xzf /tmp/pwsh.tgz; \
    chmod 0755 /opt/powershell/pwsh; \
    ln -s /opt/powershell/pwsh /usr/local/bin/pwsh; \
    rm -f /tmp/pwsh.tgz; \
    /usr/local/bin/pwsh -NoProfile -Command '$PSVersionTable.PSVersion.ToString()'

# The OpenBao client — the single upstream `bao` binary (there is no separate
# client build; this is the regular, non-HSM one, used here purely as a
# client against whatever server the session is pointed at). Same
# pin-and-checksum rules as Go/oc/PowerShell. In egress proxy mode the
# server's host must be added to the allowlist before `bao` can reach it.
ARG BAO_VERSION=2.6.1
ARG BAO_SHA256_AMD64=ca8d836eb3a5c80407e45e762300b64e7138c419e78826955f2e4ba4ce6d8a6b
ARG BAO_SHA256_ARM64=a74aa73b80000a4340a90edbf27726c0fb0a4537970eab6e1a7e0e211d117b75
RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) sha="$BAO_SHA256_AMD64" ;; \
        arm64) sha="$BAO_SHA256_ARM64" ;; \
        *) echo "no pinned openbao tarball for $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/bao.tgz "https://github.com/openbao/openbao/releases/download/v${BAO_VERSION}/openbao_${BAO_VERSION}_linux_${arch}.tar.gz"; \
    echo "$sha  /tmp/bao.tgz" | sha256sum -c -; \
    tar -C /usr/local/bin -xzf /tmp/bao.tgz bao; \
    chmod 0755 /usr/local/bin/bao; \
    rm -f /tmp/bao.tgz; \
    /usr/local/bin/bao --version

# Passwordless apt for the aibox user. This is inert by default: the runtime
# runs with no-new-privileges + cap-drop=ALL, which blocks sudo entirely. It
# only takes effect when aibox is run with --allow-pkg, which relaxes those
# two flags. Scoped to package tooling rather than a blanket ALL.
RUN echo 'aibox ALL=(root) NOPASSWD: /usr/bin/apt-get, /usr/bin/apt, /usr/bin/dpkg' \
        > /etc/sudoers.d/aibox-apt \
    && chmod 0440 /etc/sudoers.d/aibox-apt

# Strip setuid/setgid from everything except sudo (needed for --allow-pkg).
# These bits are inert under NoNewPrivs + cap-drop=ALL, but become latent
# privilege paths the moment that posture is relaxed. su, mount, passwd, chsh,
# etc. are never needed here.
RUN find / -xdev -perm /6000 -type f ! -path /usr/bin/sudo \
        -exec chmod ug-s {} + 2>/dev/null || true

# The node image ships a uid/gid 1000 user called "node". Rename it to
# "aibox"; the runtime's --userns=keep-id:uid=1000,gid=1000 aims the host user
# at this uid, whatever the host user's own uid happens to be.
RUN groupmod -n aibox node \
    && usermod -l aibox -d /home/aibox -m node

# Both assistant CLIs are baked in; which one runs (and which auth/config
# volumes are mounted) is decided per invocation by `aibox run`. The image is
# the environment; assistants are selectable components.
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_VERSION} \
                   @openai/codex@${CODEX_VERSION} \
    && npm cache clean --force

# The git shim precedes /usr/bin/git on PATH. It stops git *write* verbs
# loudly — the kernel-level enforcement is the read-only .git mount; the shim
# exists so the agent gets one clear explanation instead of a bare EROFS and
# three turns of --force escalation. Never fakes success: an agent building a
# multi-step plan on a lie fails somewhere far away.
COPY git-shim.sh /usr/local/bin/git
RUN chmod 0755 /usr/local/bin/git

# A minimal generated git identity — deliberately *not* the host ~/.gitconfig,
# which bclaude used to mount so `git commit` inside knew who you are. That
# requirement is gone: there is no git write path, so no identity and no
# credential helper belong in here. safe.directory prevents a
# dubious-ownership refusal on unusual host uid configurations; gc.auto=0
# because gc would try to write the read-only object store; fsmonitor off
# because the daemon would try to write under .git.
COPY gitconfig /home/aibox/.gitconfig

# .claude/.codex are the mountpoints for the per-assistant config volumes and
# .claude-auth/.codex-auth for the shared per-assistant login volumes;
# creating them here owned by aibox means podman's volume copy-up gets the
# ownership right. /vscode is where the Dev Containers extension auto-mounts
# its server volume — without an aibox-owned mountpoint baked in, podman
# creates it root-owned and the server install dies on "mkdir
# /vscode/vscode-server: Permission denied" (cap-drop=ALL means nothing in the
# container can chown it later). .cache is the mountpoint for the cache volume
# — the Go module cache, pip/uv wheels and npm's cache, which would otherwise
# be re-downloaded on every ephemeral run.
RUN mkdir -p /work /vscode \
        /home/aibox/.claude /home/aibox/.claude-auth \
        /home/aibox/.codex /home/aibox/.codex-auth \
        /home/aibox/.cache /home/aibox/.npm-global \
    && chown -R aibox:aibox /work /vscode /home/aibox \
    && chmod 700 /home/aibox/.claude /home/aibox/.claude-auth \
                 /home/aibox/.codex /home/aibox/.codex-auth

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

# The image manifest and the image layer of the environment notes, generated
# from the tools actually installed above so they can never drift from
# reality, and gated against the notes' byte budget — an over-budget notes
# file fails the build here rather than taxing every session's context.
ARG AIBOX_PROFILE=base
ARG AIBOX_RELEASE=local
COPY ainotes/generate-image-notes.sh /tmp/generate-image-notes.sh
COPY ainotes/ainotes /usr/local/bin/ainotes
RUN AIBOX_PROFILE="$AIBOX_PROFILE" AIBOX_RELEASE="$AIBOX_RELEASE" \
        bash /tmp/generate-image-notes.sh \
    && rm /tmp/generate-image-notes.sh \
    && chmod 0755 /usr/local/bin/ainotes

# GOPATH sits under .cache on purpose: that is the one directory an ephemeral
# run keeps (the cache volume), and nothing in a GOPATH is precious — a module
# cache and binaries you can `go install` again. GOCACHE, PIP_CACHE_DIR and
# uv's cache already default to XDG_CACHE_HOME, so they land there without
# being named; npm's does not, hence npm_config_cache. ANSIBLE_HOME puts
# galaxy collections and roles there for the same reason — fetched artifacts,
# nothing precious, re-downloadable. .local/bin is where `pip install --user`
# drops entry points; without it on PATH the tool installs and then can't be
# run.
#
# The two CA variables exist because a custom CA installed into the system
# store (the ca-certificates/ COPY above) is invisible to exactly the tools
# that matter most here: node bundles its own root list — and claude and
# codex are node programs — and python's requests uses certifi's. Both are
# pointed at the merged system bundle, which is harmless when no custom CA
# was added and essential when one was.
#
# GIT_OPTIONAL_LOCKS=0 is the single most important line of the git policy:
# without it `git status` tries to refresh and write the index, hits the
# read-only .git mount, and produces errors that send the agent down a rabbit
# hole. With it, read-only git is genuinely clean.
#
# LC_ALL/LANG=C.UTF-8: a locale that is always present in glibc (no locale-gen)
# and UTF-8 aware, so tools do not fall back to ASCII or emit "setting locale
# failed" warnings. PYTHONPATH points at a cache-volume directory so
# `pip install --target ~/.cache/pylibs` (or code that drops modules there)
# is importable and survives across ephemeral runs; a missing dir is ignored
# by Python, so this is harmless until something uses it.
ENV HOME=/home/aibox \
    SHELL=/bin/bash \
    CLAUDE_CONFIG_DIR=/home/aibox/.claude \
    CODEX_HOME=/home/aibox/.codex \
    GIT_OPTIONAL_LOCKS=0 \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    PYTHONPATH=/home/aibox/.cache/pylibs \
    XDG_CACHE_HOME=/home/aibox/.cache \
    npm_config_prefix=/home/aibox/.npm-global \
    npm_config_cache=/home/aibox/.cache/npm \
    GOPATH=/home/aibox/.cache/go \
    ANSIBLE_HOME=/home/aibox/.cache/ansible \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    PATH=/home/aibox/.local/bin:/home/aibox/.npm-global/bin:/home/aibox/.cache/go/bin:/usr/local/go/bin:/usr/local/go-tools/bin:/usr/local/bin:/usr/bin:/bin:/usr/games:/usr/local/games

# /etc/profile hands non-root users a fixed PATH, so a login shell — which is
# what VS Code's integrated terminal and `bash -l` start — throws the one
# above away, and with it the Go toolchain, the git shim and everything in
# .npm-global. Written from $PATH rather than repeating it, so the two cannot
# drift apart. Losing the shim from PATH would silently disable the loud git
# policy in terminals, so this line is policy, not convenience.
RUN printf 'PATH="%s"\nexport PATH\nexport GIT_OPTIONAL_LOCKS=0\nexport LC_ALL=C.UTF-8 LANG=C.UTF-8\nexport PYTHONPATH=/home/aibox/.cache/pylibs\n' "$PATH" \
        > /etc/profile.d/10-aibox-path.sh \
    && chmod 0644 /etc/profile.d/10-aibox-path.sh

USER aibox
WORKDIR /work

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD []
